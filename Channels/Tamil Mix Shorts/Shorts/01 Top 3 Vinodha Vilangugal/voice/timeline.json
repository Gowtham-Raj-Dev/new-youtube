{
 "voice": "Achernar",
 "segs": [
  {
   "id": "s1",
   "dur": 11.959666666666667,
   "ok": true,
   "start": 0.24,
   "end": 11.94,
   "lines": [
    {
     "text": "நீங்க கனவுல கூட நினைச்சு பாக்க முடியாத",
     "t0": 0.24,
     "t1": 7.5200000000000005
    },
    {
     "text": "அளவுக்கு விலங்குகளால செய்யப்பட்ட",
     "t0": 7.5200000000000005,
     "t1": 8.28
    },
    {
     "text": "ரொம்பவே விசித்திரமான சம்பவங்கள்!",
     "t0": 8.28,
     "t1": 10.040000000000001
    },
    {
     "text": "அதுலயும் நம்பர் ஒண்ணை பாத்தீங்கன்னா",
     "t0": 10.040000000000001,
     "t1": 11.8
    },
    {
     "text": "நீங்களே ஆச்சரியப்பட்டுருவீங்க!",
     "t0": 11.8,
     "t1": 11.94
    }
   ]
  },
  {
   "id": "s2",
   "dur": 20.719666666666665,
   "ok": true,
   "start": 0.3,
   "end": 20.7,
   "lines": [
    {
     "text": "நம்பர் மூணு. Deep sea anglerfish!",
     "t0": 0.3,
     "t1": 1.78
    },
    {
     "text": "கிட்டத்தட்ட ரெண்டாயிரம் அடி ஆழத்துல",
     "t0": 1.78,
     "t1": 4.48
    },
    {
     "text": "வாழ்ற இந்த மீன்",
     "t0": 4.48,
     "t1": 8.78
    },
    {
     "text": "திடீர்னு கடலுக்கு மேல வந்து",
     "t0": 8.78,
     "t1": 13.5
    },
    {
     "text": "ஒட்டுமொத்த உலகத்தையும் ஆச்சரியப்பட வச்சிருக்கு!",
     "t0": 13.5,
     "t1": 16.28
    },
    {
     "text": "ஆழ்கடல்ல வேட்டையாடி சாப்பிடுற இந்த மீன்",
     "t0": 16.28,
     "t1": 18.86
    },
    {
     "text": "கடலுக்கு மேல ஏன் வந்துச்சுன்னு",
     "t0": 18.86,
     "t1": 20.56
    },
    {
     "text": "இன்னும் கண்டுபிடிக்க முடியலையாம்!",
     "t0": 20.56,
     "t1": 20.7
    }
   ]
  },
  {
   "id": "s3",
   "dur": 30.479666666666667,
   "ok": true,
   "start": 0.24,
   "end": 30.46,
   "lines": [
    {
     "text": "அடுத்ததா நம்பர் ரெண்டுல இருக்குறது, இந்த ஒரு penguin!",
     "t0": 0.24,
     "t1": 2.68
    },
    {
     "text": "இந்த penguin அதோட கூட்டத்த விட்டு",
     "t0": 2.68,
     "t1": 4.26
    },
    {
     "text": "ஒரு மலைய நோக்கி தனியா நடந்து போக ஆரம்பிச்சிருக்கு.",
     "t0": 4.26,
     "t1": 9.42
    },
    {
     "text": "அது ஏன் அங்க போகுதுன்னு",
     "t0": 9.42,
     "t1": 13.74
    },
    {
     "text": "உண்மையான காரணம் யாருக்குமே தெரியலையாம்!",
     "t0": 13.74,
     "t1": 16.04
    },
    {
     "text": "அதனால மக்களெல்லாம் என்ன நினைச்சாங்கன்னா",
     "t0": 16.04,
     "t1": 18.94
    },
    {
     "text": "அந்த penguin கூட்டத்த விட்டு தனியா இருக்க ஆசைப்படுது,",
     "t0": 18.94,
     "t1": 22.14
    },
    {
     "text": "இல்லனா அதுக்கு மலைய நோக்கி போற ஒரு goal இருக்கு,",
     "t0": 22.14,
     "t1": 25.080000000000002
    },
    {
     "text": "இல்லனா சுத்தி பாக்க போகுதுன்னு சொல்ல ஆரம்பிச்சிட்டாங்க.",
     "t0": 25.080000000000002,
     "t1": 28.22
    },
    {
     "text": "செத்துருவேன்னு தெரிஞ்சும் தனியா போன இந்த penguin-அ",
     "t0": 28.22,
     "t1": 30.32
    },
    {
     "text": "எல்லாருமே motivation-ஆ எடுத்துக்கிட்டாங்க!",
     "t0": 30.32,
     "t1": 30.46
    }
   ]
  },
  {
   "id": "s4",
   "dur": 13.679666666666666,
   "ok": true,
   "start": 0.2,
   "end": 13.66,
   "lines": [
    {
     "text": "ரொம்பவே interesting-ஆன நம்பர் ஒண்ணை பாக்குறதுக்கு முன்னாடி,",
     "t0": 0.2,
     "t1": 3.94
    },
    {
     "text": "fisherman life ரொம்ப கஷ்டம்னு நினைக்கிறவங்க",
     "t0": 3.94,
     "t1": 6.82
    },
    {
     "text": "இந்த video-க்கு ஒரு like பண்ணிட்டு",
     "t0": 6.82,
     "t1": 8.88
    },
    {
     "text": "ஒரு red heart comment பண்ணுங்க!",
     "t0": 8.88,
     "t1": 11
    },
    {
     "text": "பாக்கலாம், எத்தனை பேர் comment பண்றீங்கன்னு!",
     "t0": 11,
     "t1": 13.66
    }
   ]
  },
  {
   "id": "s5",
   "dur": 19.079666666666668,
   "ok": true,
   "start": 0.28,
   "end": 19.06,
   "lines": [
    {
     "text": "அப்படி நம்பர் ஒண்ணுல இருக்கறது தான், இந்த ஒரு dolphin!",
     "t0": 0.28,
     "t1": 4.6000000000000005
    },
    {
     "text": "இந்த தாய் dolphin",
     "t0": 4.6000000000000005,
     "t1": 6.2
    },
    {
     "text": "அதோட குட்டி இறந்து போனது தெரியாம",
     "t0": 6.2,
     "t1": 8.74
    },
    {
     "text": "கிட்டத்தட்ட பல நாட்கள்",
     "t0": 8.74,
     "t1": 13.1
    },
    {
     "text": "அதோட முதுகுலயே வச்சு சுமந்துட்டு இருந்திருக்கு.",
     "t0": 13.1,
     "t1": 15.84
    },
    {
     "text": "தாய் பாசம்ங்கறது மனுஷங்களுக்கு மட்டும் இல்ல,",
     "t0": 15.84,
     "t1": 17.34
    },
    {
     "text": "விலங்குகளுக்கும் இருக்குன்னு",
     "t0": 17.34,
     "t1": 18.92
    },
    {
     "text": "இந்த dolphin புரிய வச்சிருக்கு!",
     "t0": 18.92,
     "t1": 19.06
    }
   ]
  }
 ]
}