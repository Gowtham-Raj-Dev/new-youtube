# Copy to functions/.env — non-secret parameters for Cloud Functions.
# Secrets (client secret, encryption key) go in Secret Manager, never here:
#   firebase functions:secrets:set YOUTUBE_OAUTH_CLIENT_SECRET
#   firebase functions:secrets:set TOKEN_ENCRYPTION_KEY

YOUTUBE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
YOUTUBE_OAUTH_REDIRECT_URI=https://fir-4b5dc.web.app/api/youtube/callback
APP_ORIGINS=https://fir-4b5dc.web.app,https://fir-4b5dc.firebaseapp.com,http://localhost:3000
# Shorts each non-owner account may publish per day — every user shares one YouTube API quota.
DAILY_UPLOADS_PER_USER=10
