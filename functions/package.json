{
  "name": "shortflow-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --sourcemap --outfile=lib/index.js --external:firebase-functions --external:firebase-admin --external:ffmpeg-static --external:@ffprobe-installer/ffprobe --external:@napi-rs/canvas --alias:@shortflow/shared=../packages/shared/src/index.ts",
    "helper": "esbuild src/local/split-server.ts --bundle --platform=node --target=node22 --format=cjs --outfile=.local/split-server.js --log-level=warning --external:firebase-functions --external:firebase-admin --external:ffmpeg-static --external:@ffprobe-installer/ffprobe --alias:@shortflow/shared=../packages/shared/src/index.ts && node .local/split-server.js",
    "typecheck": "tsc --noEmit",
    "deploy": "firebase deploy --only functions",
    "pack-helper": "node scripts/pack-helper.mjs",
    "make-videos": "esbuild scripts/make-videos.ts --bundle --platform=node --target=node22 --format=cjs --outfile=.local/make-videos.js --log-level=warning --external:firebase-functions --external:firebase-admin --external:ffmpeg-static --external:@ffprobe-installer/ffprobe --external:@napi-rs/canvas --alias:@shortflow/shared=../packages/shared/src/index.ts && node .local/make-videos.js",
    "add-to-app": "esbuild scripts/add-to-app.ts --bundle --platform=node --target=node22 --format=cjs --outfile=.local/add-to-app.js --log-level=warning --external:firebase-functions --external:firebase-admin --external:ffmpeg-static --external:@ffprobe-installer/ffprobe --external:@napi-rs/canvas --alias:@shortflow/shared=../packages/shared/src/index.ts && node .local/add-to-app.js",
    "schedule-shorts": "esbuild scripts/schedule-shorts.ts --bundle --platform=node --target=node22 --format=cjs --outfile=.local/schedule-shorts.js --log-level=warning --external:firebase-functions --external:firebase-admin --external:ffmpeg-static --external:@ffprobe-installer/ffprobe --external:@napi-rs/canvas --alias:@shortflow/shared=../packages/shared/src/index.ts && node .local/schedule-shorts.js",
    "make-real": "esbuild scripts/make-real.ts --bundle --platform=node --target=node22 --format=cjs --outfile=.local/make-real.js --log-level=warning --external:firebase-functions --external:firebase-admin --external:ffmpeg-static --external:@ffprobe-installer/ffprobe --external:@napi-rs/canvas --alias:@shortflow/shared=../packages/shared/src/index.ts && node .local/make-real.js",
    "long-voice": "esbuild scripts/long-voice.ts --bundle --platform=node --target=node22 --format=cjs --outfile=.local/long-voice.js --log-level=warning --external:firebase-functions --external:firebase-admin --external:ffmpeg-static --external:@ffprobe-installer/ffprobe --external:@napi-rs/canvas --alias:@shortflow/shared=../packages/shared/src/index.ts && node .local/long-voice.js",
    "long-video": "esbuild scripts/long-video.ts --bundle --platform=node --target=node22 --format=cjs --outfile=.local/long-video.js --log-level=warning --external:firebase-functions --external:firebase-admin --external:ffmpeg-static --external:@ffprobe-installer/ffprobe --external:@napi-rs/canvas --alias:@shortflow/shared=../packages/shared/src/index.ts && node .local/long-video.js",
    "long-to-app": "esbuild scripts/long-to-app.ts --bundle --platform=node --target=node22 --format=cjs --outfile=.local/long-to-app.js --log-level=warning --external:firebase-functions --external:firebase-admin --external:ffmpeg-static --external:@ffprobe-installer/ffprobe --external:@napi-rs/canvas --alias:@shortflow/shared=../packages/shared/src/index.ts && node .local/long-to-app.js",
    "codelove-shorts": "esbuild scripts/codelove-shorts-to-app.ts --bundle --platform=node --target=node22 --format=cjs --outfile=.local/codelove-shorts.js --log-level=warning --external:firebase-functions --external:firebase-admin --external:ffmpeg-static --external:@ffprobe-installer/ffprobe --external:@napi-rs/canvas --alias:@shortflow/shared=../packages/shared/src/index.ts && node .local/codelove-shorts.js",
    "preview-auto": "esbuild scripts/preview-auto-short.ts --bundle --platform=node --target=node22 --format=cjs --outfile=.local/preview-auto.js --log-level=warning --external:firebase-functions --external:firebase-admin --external:ffmpeg-static --external:@ffprobe-installer/ffprobe --external:@napi-rs/canvas --alias:@shortflow/shared=../packages/shared/src/index.ts && node .local/preview-auto.js"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@napi-rs/canvas": "^1.0.11",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.3"
  }
}
